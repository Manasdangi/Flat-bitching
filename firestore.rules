rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /reviews/{id} {
      allow read: if true;
      // Anyone can post, but only well-formed reviews. No edits or deletes from the client.
      allow create: if request.resource.data.keys().hasOnly(['sectorId','name','rating','tags','text','createdAt'])
        && request.resource.data.sectorId is string && request.resource.data.sectorId.size() <= 20
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 6
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
