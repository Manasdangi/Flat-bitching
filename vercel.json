{
  "redirects": [
    {
      "source": "/((?!google35d59337b48c50a0\\.html).*)",
      "has": [
        {
          "type": "host",
          "value": "gurgaon-flat-finder.vercel.app"
        }
      ],
      "destination": "https://www.kahanrahe.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/share",
      "destination": "/api/share"
    },
    {
      "source": "/((?!api/|share|fonts/|assets/|sw\\.js|manifest\\.webmanifest|sitemap\\.xml|robots\\.txt|og\\.png|favicon\\.svg|icon-.*\\.png|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/og.ts": {
      "includeFiles": "node_modules/harfbuzzjs/**"
    }
  }
}
