{
  "rewrites": [
    {
      "source": "/((?!api/|share|fonts/|assets/|sw\\.js|manifest\\.webmanifest|sitemap\\.xml|robots\\.txt|og\\.png|favicon\\.svg|icon-.*\\.png|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/og.ts": {
      "includeFiles": "node_modules/harfbuzzjs/**"
    }
  }
}
